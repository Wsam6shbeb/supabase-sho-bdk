# Frontend runtime configuration. Never put secrets here.
# Backend documented in the integration specification:
# /api/auth/, /wallet/api/, /services/api/
EXPO_PUBLIC_API_MODE=http
EXPO_PUBLIC_API_URL=https://YOUR-BACKEND-DOMAIN

# Google OAuth browser client ID used to obtain the ID token sent to /api/auth/google/
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
