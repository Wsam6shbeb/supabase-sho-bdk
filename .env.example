# Frontend runtime configuration. Never put secrets here.
# Supabase project connection (see src/services/supabase.ts).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth browser client ID used for Supabase Google sign-in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
